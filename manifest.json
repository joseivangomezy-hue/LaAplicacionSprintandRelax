                                                            <button onClick={() => handleAddRecord(test.id)} className="text-white px-5 rounded-[12px] text-[14px] font-black active:scale-95 transition-all shadow-md bg-orange-500"><Plus size={18}/></button>
                                                        </div>

                                                        {test.records.length > 0 && (
