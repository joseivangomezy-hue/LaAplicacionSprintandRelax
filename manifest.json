                                                                                {item.series}x{item.reps} {item.ritmo ? <span className="text-gray-500 ml-1">@{item.ritmo}</span> : (item.rpe ? <span className="text-orange-600 ml-1">RPE {item.rpe}</span> : '')}
                                                                            </span>
