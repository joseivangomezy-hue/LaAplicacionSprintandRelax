                                <button onClick={() => setActiveVideo(null)} className="w-12 h-12 bg-white rounded-full flex items-center justify-center text-gray-900 active:scale-90 transition-all shadow-lg border border-gray-200">
                                    <X size={24} />
                                </button>
                            </div>
                            <div className="w-full max-w-xl px-4">
                                <div className="aspect-video bg-black rounded-2xl overflow-hidden border border-gray-700 shadow-2xl">
                                    <iframe 
                                        src={`https://www.youtube.com/embed/${activeVideo}?autoplay=1`} 
                                        className="w-full h-full" 
                                        frameBorder="0" 
                                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                                        allowFullScreen
                                    ></iframe>
                                </div>
                                <p className="text-center text-[12px] font-black uppercase tracking-widest text-gray-400 mt-6">Si el vídeo da error, usa el botón superior para abrirlo en YouTube</p>
                            </div>
                        </div>
                    )}

                </div>
            );
        };

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
</body>
</html>
