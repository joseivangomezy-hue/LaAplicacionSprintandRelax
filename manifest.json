                                                                <div className="flex justify-between items-center gap-2">
                                                                    <span className="text-gray-900 font-black uppercase tracking-tight text-[13px]">{block.subType}</span>
                                                                    <span className="font-black text-orange-500 text-[14px] text-right">
                                                                        {block.subType === 'rodaje' ? `${block.distancia}km @ ${block.ritmo}` : 
