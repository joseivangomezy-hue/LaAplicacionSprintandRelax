                                                                        `${block.reps} reps (${block.tiempoFuerte}/${block.tiempoSuave})`}
                                                                    </span>
                                                                </div>
                                                            )}

                                                            {(['fuerza', 'natacion', 'cuerda'].includes(selectedProfileDay.session.type)) && block.items && (
                                                                <div className="space-y-2.5">
