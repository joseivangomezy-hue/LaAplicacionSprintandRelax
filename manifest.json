<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    
    <!-- Metaetiquetas para PWA y comportamiento nativo en iOS/Android -->
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="theme-color" content="#F9FAFB">
    <meta name="mobile-web-app-capable" content="yes">
    <title>Sprint & Relax App</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- FontAwesome para Iconos -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- React & ReactDOM -->
    <script src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
    <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
    
    <!-- Babel para compilar JSX en el navegador -->
    <script src="https://unpkg.com/@babel/standalone@7.23.6/babel.min.js"></script>
    
    <!-- MP4Box para extraer metadatos del video (Auto-FPS) -->
    <script src="https://unpkg.com/mp4box@0.5.3/dist/mp4box.all.min.js"></script>

    <!-- Chart.js para Radar de Progresión -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        /* CSS para comportamiento 100% nativo (PWA App) */
        :root { color-scheme: light; }
        body { 
            font-family: -apple-system, BlinkMacSystemFont, 'Inter', 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; 
            -webkit-tap-highlight-color: transparent;
            touch-action: manipulation;
            user-select: none;
            -webkit-user-select: none;
            background-color: #F9FAFB; /* Fondo general blanco/gris muy claro */
            color: #111827; /* Texto principal oscuro */
            overscroll-behavior: none;
            overflow-x: hidden;
            max-width: 100vw;
        }
        html { 
            overscroll-behavior: none; 
            overflow-x: hidden;
            max-width: 100vw;
        }
        
        input, textarea, select {
            user-select: auto;
            -webkit-user-select: auto;
            font-size: 16px !important; /* Mantiene 16px para evitar auto-zoom en iOS Safari */
        }
        
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
</head>
<body>
    <div id="root"></div>

    <script type="text/babel">
        const { useState, useEffect, useRef } = React;

        const Icon = ({ name, size = 20, className = "" }) => (
            <i className={`${name} ${className}`} style={{ fontSize: size, display: 'inline-flex', alignItems: 'center', justifyContent: 'center', width: size, height: size }}></i>
        );
        
        const Dumbbell = (p) => (<Icon name="fa-solid fa-dumbbell" {...p} />);
        const Timer = (p) => (<Icon name="fa-solid fa-stopwatch" {...p} />);
        const Plus = (p) => (<Icon name="fa-solid fa-plus" {...p} />);
        const Trash2 = (p) => (<Icon name="fa-solid fa-trash-can" {...p} />);
        const Save = (p) => (<Icon name="fa-solid fa-floppy-disk" {...p} />);
        const ChevronLeft = (p) => (<Icon name="fa-solid fa-chevron-left" {...p} />);
        const ChevronRight = (p) => (<Icon name="fa-solid fa-chevron-right" {...p} />);
        const ArrowLeft = (p) => (<Icon name="fa-solid fa-arrow-left" {...p} />);
        const X = (p) => (<Icon name="fa-solid fa-xmark" {...p} />);
        const Clock = (p) => (<Icon name="fa-regular fa-clock" {...p} />);
        const Waves = (p) => (<Icon name="fa-solid fa-water" {...p} />);
        const Zap = (p) => (<Icon name="fa-solid fa-bolt" {...p} />);
        const FileText = (p) => (<Icon name="fa-regular fa-file-lines" {...p} />);
        const Calendar = (p) => (<Icon name="fa-regular fa-calendar" {...p} />);
        const Activity = (p) => (<Icon name="fa-solid fa-chart-line" {...p} />);
        const Trophy = (p) => (<Icon name="fa-solid fa-trophy" {...p} />);
        const StickyNote = (p) => (<Icon name="fa-regular fa-note-sticky" {...p} />);
        const CheckCircle2 = (p) => (<Icon name="fa-regular fa-circle-check" {...p} />);
        const Moon = (p) => (<Icon name="fa-solid fa-moon" {...p} />);
        const Smartphone = (p) => (<Icon name="fa-solid fa-mobile-screen-button" {...p} />);
        const Pen = (p) => (<Icon name="fa-solid fa-pen" {...p} />);
        const Calculator = (p) => (<Icon name="fa-solid fa-calculator" {...p} />);
        const VideoIcon = (p) => (<Icon name="fa-solid fa-video" {...p} />);
        const Youtube = (p) => (<Icon name="fa-brands fa-youtube" {...p} />);
        const StepBackward = (p) => (<Icon name="fa-solid fa-backward-step" {...p} />);
        const StepForward = (p) => (<Icon name="fa-solid fa-forward-step" {...p} />);
        const User = (p) => (<Icon name="fa-solid fa-user" {...p} />);
        const Menu = (p) => (<Icon name="fa-solid fa-bars" {...p} />);
        const Logout = (p) => (<Icon name="fa-solid fa-arrow-right-from-bracket" {...p} />);
        const ChevronDown = (p) => (<Icon name="fa-solid fa-chevron-down" {...p} />);
        const ChevronUp = (p) => (<Icon name="fa-solid fa-chevron-up" {...p} />);

        const parseTestValue = (val) => {
            if (!val) return { num: 0, isTime: false };
            const str = val.toString().trim();
            if (str.includes(':')) {
                const parts = str.split(':');
                let seconds = 0;
                if (parts.length === 3) {
                    seconds = parseInt(parts[0] || 0) * 3600 + parseInt(parts[1] || 0) * 60 + parseFloat(parts[2] || 0);
                } else {
                    seconds = parseInt(parts[0] || 0) * 60 + parseFloat(parts[1] || 0);
                }
                return { num: seconds, isTime: true };
            }
            return { num: parseFloat(str.replace(',', '.')) || 0, isTime: false };
        };

        const MultiTestChart = ({ tests }) => {
            const chartRef = useRef(null);
            const chartInstance = useRef(null);

            const activeTests = tests.filter(t => t.records && t.records.length > 0);

            useEffect(() => {
                if (activeTests.length === 0) {
                    if (chartInstance.current) chartInstance.current.destroy();
                    return;
                }

                const labels = [];
                const latestPoints = [];
                const bestPoints = []; // 100% siempre

                const rawValues = { latest: [], best: [], isPR: [] };

                activeTests.forEach(test => {
                    labels.push(test.name || 'Prueba');
                    
                    const parsedRecords = test.records.map(r => ({
                        ...r,
                        parsed: parseTestValue(r.value)
                    }));
                    
                    parsedRecords.sort((a, b) => new Date(a.date) - new Date(b.date));
                    
                    const latestRecord = parsedRecords[parsedRecords.length - 1];
                    const isTimeTest = latestRecord.parsed.isTime;
                    
                    let bestRecord = parsedRecords[0];
                    parsedRecords.forEach(r => {
                        if (isTimeTest) {
                            if (r.parsed.num < bestRecord.parsed.num) bestRecord = r;
                        } else {
                            if (r.parsed.num > bestRecord.parsed.num) bestRecord = r;
                        }
                    });

                    const bestVal = bestRecord.parsed.num;
                    const latestVal = latestRecord.parsed.num;
                    const isNewPR = latestVal === bestVal;

                    // Dinámica de Lupa
                    let dynamicFloor = isTimeTest ? bestVal * 1.20 : bestVal * 0.80;

                    const calcScore = (val) => {
                        if (isTimeTest) {
                            if (val <= bestVal) return 100;
                            if (val >= dynamicFloor) return 10; 
                            return 10 + (90 * ((dynamicFloor - val) / (dynamicFloor - bestVal)));
                        } else {
                            if (val >= bestVal) return 100;
                            if (val <= dynamicFloor) return 10;
                            return 10 + (90 * ((val - dynamicFloor) / (bestVal - dynamicFloor)));
                        }
                    };

                    latestPoints.push(calcScore(latestVal));
                    bestPoints.push(100);
                    
                    rawValues.latest.push(latestRecord.value);
                    rawValues.best.push(bestRecord.value);
                    rawValues.isPR.push(isNewPR);
                });

                while (labels.length < 3) {
                    labels.push('-');
                    latestPoints.push(0);
                    bestPoints.push(100);
                    rawValues.latest.push('-');
                    rawValues.best.push('-');
                    rawValues.isPR.push(false);
                }

                const ctx = chartRef.current.getContext('2d');
                if (chartInstance.current) chartInstance.current.destroy();

                chartInstance.current = new window.Chart(ctx, {
                    type: 'radar',
                    data: {
                        labels: labels,
                        datasets: [
                            {
                                label: 'Última Marca',
                                data: latestPoints,
                                backgroundColor: 'rgba(249, 115, 22, 0.7)', 
                                borderColor: '#EA580C', 
                                borderWidth: 3,
                                pointBackgroundColor: '#FFFFFF',
                                pointBorderColor: '#EA580C',
                                pointHoverBackgroundColor: '#EA580C',
                                pointHoverBorderColor: '#FFFFFF',
                                pointRadius: 6,
                                pointBorderWidth: 2,
                                fill: true,
                                order: 1
                            },
                            {
                                label: 'Récord (PR)',
                                data: bestPoints,
                                backgroundColor: 'transparent', 
                                borderColor: '#111827', 
                                borderWidth: 2,
                                borderDash: [6, 4],
                                pointRadius: 0,
                                fill: false,
                                order: 2
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: { mode: 'index', intersect: false },
                        scales: {
                            r: {
                                min: 0, max: 100,
                                ticks: { display: false, stepSize: 20 },
                                grid: { color: 'rgba(0, 0, 0, 0.05)', circular: false, lineWidth: 1.5 },
                                angleLines: { color: 'rgba(0, 0, 0, 0.1)', lineWidth: 1.5 },
                                pointLabels: {
                                    font: { family: 'Inter, sans-serif', size: 14, weight: '900' }, /* Aumentado tamaño fuente de labels */
                                    color: '#111827',
                                    padding: 16
                                }
                            }
                        },
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                backgroundColor: 'rgba(255, 255, 255, 0.95)',
                                titleColor: '#F97316',
                                bodyColor: '#111827',
                                borderColor: '#E5E7EB',
                                borderWidth: 1,
                                padding: 14,
                                bodyFont: { size: 15, weight: 'bold' }, /* Aumentado tamaño fuente de tooltip */
                                titleFont: { size: 14, weight: 'bold' },
                                displayColors: false,
                                callbacks: {
                                    title: function(context) { return context[0].label.toUpperCase(); },
                                    label: function(context) {
                                        const index = context.dataIndex;
                                        if (labels[index] === '-') return null;
                                        const isPr = rawValues.isPR[index];
                                        
                                        if (context.datasetIndex === 0) {
                                            return isPr 
                                                ? `🏆 PR CONSEGUIDO: ${rawValues.latest[index]}` 
                                                : `🔥 Última: ${rawValues.latest[index]}`;
                                        }
                                        if (context.datasetIndex === 1 && !isPr) {
                                            return `🎯 A Batir: ${rawValues.best[index]}`;
                                        }
                                        return null;
                                    }
                                }
                            }
                        }
                    }
                });

                return () => {
                    if (chartInstance.current) chartInstance.current.destroy();
                };
            }, [activeTests]);

            if (activeTests.length === 0) return null;

            return (
                <div className="w-full py-2 flex flex-col items-center">
                    <div className="w-full max-w-[320px] aspect-square relative mx-auto">
                        <canvas ref={chartRef}></canvas>
                    </div>
                    <div className="flex justify-center gap-5 mt-5">
                        <div className="flex items-center gap-2 text-[12px] font-bold text-gray-600 uppercase">
                            <div className="w-4 h-4 bg-orange-500 rounded-sm"></div> Última
                        </div>
                        <div className="flex items-center gap-2 text-[12px] font-bold text-gray-600 uppercase">
                            <div className="w-4 h-0 border-t-2 border-dashed border-gray-900"></div> Récord (PR)
                        </div>
                    </div>
                </div>
            );
        };

        const SamuraiFireHelmet = ({ size = 26, className = "" }) => (
            <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.75" strokeLinecap="round" strokeLinejoin="round" className={className}>
                <path d="M5 14l-2 3.5C2 19 3 21 6 21h12c3 0 4-2 3.5-3.5L19 14" />
                <path d="M4.5 17.5h15" />
                <path d="M5 14v-3a7 7 0 0 1 14 0v3" />
                <path d="M12 4v4" />
                <path d="M10.5 8h3l-.5 4h-2z" />
                <path d="M10.5 8C8 6 5 4.5 2 4.5" />
                <path d="M13.5 8C16 6 19 4.5 22 4.5" />
            </svg>
        );

        const App = () => {
            const [activeTab, setActiveTab] = useState('calendario'); 
            const [editingDay, setEditingDay] = useState(null); 
            const [showExitConfirm, setShowExitConfirm] = useState(false);
            const [isMenuOpen, setIsMenuOpen] = useState(false);
            
            const [selectedYear, setSelectedYear] = useState(new Date().getFullYear());
            const [currentMesocycle, setCurrentMesocycle] = useState(1);
            const [currentWeek, setCurrentWeek] = useState(1);
            
            const [plan, setPlan] = useState(() => {
                const savedPlan = localStorage.getItem('sprintRelaxPlan');
                return savedPlan ? JSON.parse(savedPlan) : {};
            }); 
            
            const [sessionType, setSessionType] = useState('carrera');
            const [sessionName, setSessionName] = useState('');
            const [intervals, setIntervals] = useState([]); 
            const [swimBlocks, setSwimBlocks] = useState([]);
            const [ropeBlocks, setRopeBlocks] = useState([]);
            const [exercises, setExercises] = useState([]);

            const [activeTool, setActiveTool] = useState('vam');
            const [vamDistance, setVamDistance] = useState('2000');
            const [vamMin, setVamMin] = useState('7');
            const [vamSec, setVamSec] = useState('30');
            const [userAge, setUserAge] = useState('30');
            const [userGender, setUserGender] = useState('M');
            const [userRestingHr, setUserRestingHr] = useState('60');

            const [swimDistance, setSwimDistance] = useState('400');
            const [swimMin, setSwimMin] = useState('6');
            const [swimSec, setSwimSec] = useState('00');
            const [pullupBw, setPullupBw] = useState('75');
            const [pullupAw, setPullupAw] = useState('20');
            const [pullupReps, setPullupReps] = useState('5');
            const [targetReps, setTargetReps] = useState('8');
            const [targetRpe, setTargetRpe] = useState('8');

            const [savedROMs, setSavedROMs] = useState(() => {
                const saved = localStorage.getItem('sprintRelaxROMs');
                return saved ? JSON.parse(saved) : { sentadilla: '60', banca: '45', muerto: '50', dominadas: '55' };
            });
            const [vbtExercise, setVbtExercise] = useState('sentadilla');
            const [vbtRom, setVbtRom] = useState(() => {
                const saved = localStorage.getItem('sprintRelaxROMs');
                const parsed = saved ? JSON.parse(saved) : { sentadilla: '60', banca: '45', muerto: '50', dominadas: '55' };
                return parsed['sentadilla'];
            });
            const [vbtWeight, setVbtWeight] = useState('100');
            const [vbtFps, setVbtFps] = useState('60');
            const [isDetectingFps, setIsDetectingFps] = useState(false);
            const [vbtVideoUrl, setVbtVideoUrl] = useState(null);
            const [vbtStartTime, setVbtStartTime] = useState(null);
            const [vbtEndTime, setVbtEndTime] = useState(null);
            const [vbtTargetReps, setVbtTargetReps] = useState('5');
            const [vbtTargetRpe, setVbtTargetRpe] = useState('8');
            const videoRef = useRef(null);

            const [saved1RMs, setSaved1RMs] = useState(() => {
                const saved = localStorage.getItem('sprintRelax1RMs');
                return saved ? JSON.parse(saved) : { sentadilla: 0, banca: 0, muerto: 0, dominadas: 0 };
            });
            const [customTests, setCustomTests] = useState(() => {
                const saved = localStorage.getItem('sprintRelaxCustomTests');
                return saved ? JSON.parse(saved) : [];
            });
            const [journalNotes, setJournalNotes] = useState(() => {
                const saved = localStorage.getItem('sprintRelaxJournal');
                return saved ? JSON.parse(saved) : {};
            });

            const [profileDate, setProfileDate] = useState(new Date());
            const [selectedProfileDay, setSelectedProfileDay] = useState(null);
            const [activeVideo, setActiveVideo] = useState(null);
            
            const [expandedSections, setExpandedSections] = useState({
                rms: true,
                tests: true,
                history: true
            });

            const toggleSection = (section) => {
                setExpandedSections(prev => ({ ...prev, [section]: !prev[section] }));
            };

            const days = ['Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado', 'Domingo'];
            const weekScrollRef = useRef(null);
            const startWeek = (currentMesocycle - 1) * 4 + 1;

            useEffect(() => { localStorage.setItem('sprintRelaxPlan', JSON.stringify(plan)); }, [plan]);
            useEffect(() => { localStorage.setItem('sprintRelax1RMs', JSON.stringify(saved1RMs)); }, [saved1RMs]);
            useEffect(() => { localStorage.setItem('sprintRelaxROMs', JSON.stringify(savedROMs)); }, [savedROMs]);
            useEffect(() => { localStorage.setItem('sprintRelaxCustomTests', JSON.stringify(customTests)); }, [customTests]);
            useEffect(() => { localStorage.setItem('sprintRelaxJournal', JSON.stringify(journalNotes)); }, [journalNotes]);

            const calculateSwimPace = () => {
                const d = parseFloat(swimDistance) || 0;
                const m = parseInt(swimMin) || 0;
                const s = parseInt(swimSec) || 0;
                const totalSeconds = (m * 60) + s;
                if (d === 0 || totalSeconds === 0) return 0;
                return (totalSeconds / d) * 100;
            };
            const currentSwimPace = calculateSwimPace();

            const getSwimPace100m = (basePaceSec, percent) => {
                if (basePaceSec === 0) return "0:00";
                const targetSec = basePaceSec / (percent / 100);
                const mins = Math.floor(targetSec / 60);
                const secs = (targetSec % 60).toFixed(0);
                return `${mins}:${secs.padStart(2, '0')}`;
            };
            const getSwimPace25m = (basePaceSec, percent) => {
                if (basePaceSec === 0) return "0:00.0";
                const targetSec100 = basePaceSec / (percent / 100);
                const targetSec25 = targetSec100 / 4;
                const mins = Math.floor(targetSec25 / 60);
                const secs = (targetSec25 % 60).toFixed(1);
                if (mins > 0) return `${mins}:${secs.padStart(4, '0')}`;
                return `${secs}s`;
            };

            const calculateVAM = () => {
                const d = parseFloat(vamDistance) || 0;
                const m = parseInt(vamMin) || 0;
                const s = parseInt(vamSec) || 0;
                const totalSeconds = (m * 60) + s;
                if (d === 0 || totalSeconds === 0) return 0;
                return (d / totalSeconds) * 3.6;
            };
            const currentVam = calculateVAM();

            const getKarvonenHR = (percent) => {
                const age = parseInt(userAge) || 30;
                const restHr = parseInt(userRestingHr) || 60;
                const maxHr = userGender === 'F' ? 226 - age : 220 - age;
                const hrr = maxHr - restHr;
                return Math.round((hrr * (percent / 100)) + restHr);
            };

            const getPace100m = (vamKmh, percent) => {
                if (vamKmh === 0) return "0:00.0";
                const targetVamKmh = vamKmh * (percent / 100);
                const targetMs = targetVamKmh / 3.6;
                if (targetMs === 0) return "0:00.0";
                const sec100m = 100 / targetMs;
                const mins = Math.floor(sec100m / 60);
                const secs = (sec100m % 60).toFixed(1);
                return `${mins}:${secs.padStart(4, '0')}`;
            };

            const bw = parseFloat(pullupBw) || 0;
            const aw = parseFloat(pullupAw) || 0;
            const reps = parseInt(pullupReps) || 0;
            const tReps = parseInt(targetReps) || 0;
            const tRpe = parseFloat(targetRpe) || 0;
            const totalWeight = bw + aw;
            
            const total1Rm = reps > 0 ? totalWeight * (1 + (reps - 1) / 30) : 0;
            const lastre1Rm = total1Rm - bw;
            const theoreticalReps = tReps + Math.max(0, 10 - tRpe);
            const targetTotalWeight = theoreticalReps > 0 && total1Rm > 0 ? total1Rm / (1 + (theoreticalReps - 1) / 30) : 0;
            const recommendedLastre = targetTotalWeight > 0 ? targetTotalWeight - bw : 0;
            
            const formatLastre = (weight) => {
                if (weight > 0) return `+${weight.toFixed(1)} kg`;
                if (weight < 0) return `-${Math.abs(weight).toFixed(1)} kg (Asistidas)`;
                return `0 kg (Peso corp.)`;
            };

            const getFirstMondayOfYear = (year) => {
                let date = new Date(year, 0, 1);
                while (date.getDay() !== 1) date.setDate(date.getDate() + 1);
                return date;
            };

            const getMesocycleDates = (year, meso) => {
                const firstMonday = getFirstMondayOfYear(year);
                const startDaysOffset = (meso - 1) * 28;
                const startDate = new Date(firstMonday);
                startDate.setDate(startDate.getDate() + startDaysOffset);
                const endDate = new Date(startDate);
                endDate.setDate(endDate.getDate() + 27);
                return `${startDate.toLocaleDateString('es-ES', { month: 'short', day: 'numeric' })} - ${endDate.toLocaleDateString('es-ES', { month: 'short', day: 'numeric' })}`;
            };

            const getExactDate = (year, week, dayIndex) => {
                const firstMonday = getFirstMondayOfYear(year);
                const targetDate = new Date(firstMonday);
                targetDate.setDate(targetDate.getDate() + (week - 1) * 7 + dayIndex);
                return targetDate;
            };

            const handlePrevMeso = () => {
                if (currentMesocycle > 1) {
                    const newMeso = currentMesocycle - 1;
                    setCurrentMesocycle(newMeso);
                    setCurrentWeek((newMeso - 1) * 4 + 1);
                }
            };
            const handleNextMeso = () => {
                const newMeso = currentMesocycle + 1;
                setCurrentMesocycle(newMeso);
                setCurrentWeek((newMeso - 1) * 4 + 1);
            };

            const openEditor = (year, week, day) => {
                const key = plan[`${year}-${week}-${day}`] ? `${year}-${week}-${day}` : `${week}-${day}`;
                const session = plan[key] || plan[`${year}-${week}-${day}`];
                
                setEditingDay({ year, week, day });
                if (session) {
                    setSessionType(session.type);
                    setSessionName(session.name);
                    if (session.type === 'carrera') setIntervals(session.data || []);
                    else if (session.type === 'fuerza') setExercises(session.data || []);
                    else if (session.type === 'natacion') setSwimBlocks(session.data || []);
                    else if (session.type === 'cuerda') setRopeBlocks(session.data || []);
                    else if (session.type === 'descanso') { setIntervals([]); setExercises([]); setSwimBlocks([]); setRopeBlocks([]); }
                } else {
                    setSessionType('carrera'); setSessionName(''); setIntervals([]); setExercises([]); setSwimBlocks([]); setRopeBlocks([]);
                }
                setActiveTab('editor');
            };

            const saveAndReturn = () => {
                if (!editingDay) return;
                let data = [];
                if (sessionType === 'carrera') data = [...intervals];
                else if (sessionType === 'fuerza') data = [...exercises];
                else if (sessionType === 'natacion') data = [...swimBlocks];
                else if (sessionType === 'cuerda') data = [...ropeBlocks];
                else if (sessionType === 'descanso') data = [];

                const key = `${editingDay.year}-${editingDay.week}-${editingDay.day}`;
                const fallbackKey = `${editingDay.week}-${editingDay.day}`;
                const existingNotes = plan[key]?.notasAlumno || plan[fallbackKey]?.notasAlumno || '';
                
                const newPlan = { ...plan };
                if (newPlan[fallbackKey]) delete newPlan[fallbackKey];

                newPlan[key] = {
                    name: sessionType === 'descanso' ? 'Día de descanso' : (sessionName || `Sesión de ${sessionType}`),
                    type: sessionType,
                    data: data,
                    notasAlumno: existingNotes 
                };
                setPlan(newPlan);
                setEditingDay(null);
                setActiveTab('calendario');
            };

            const deleteSession = () => {
                if (!editingDay) return;
                const key = `${editingDay.year}-${editingDay.week}-${editingDay.day}`;
                const fallbackKey = `${editingDay.week}-${editingDay.day}`;
                const newPlan = { ...plan };
                if (newPlan[key]) delete newPlan[key];
                if (newPlan[fallbackKey]) delete newPlan[fallbackKey];
                setPlan(newPlan);
                setEditingDay(null);
                setActiveTab('calendario');
            };

            const updateStudentNotes = (year, week, day, notes) => {
                const key = plan[`${year}-${week}-${day}`] ? `${year}-${week}-${day}` : `${week}-${day}`;
                if(plan[key]) {
                    setPlan(prev => ({...prev, [key]: { ...prev[key], notasAlumno: notes }}));
                }
            };

            const toggleSessionCompletion = (year, week, day) => {
                const key = plan[`${year}-${week}-${day}`] ? `${year}-${week}-${day}` : `${week}-${day}`;
                if(plan[key]) {
                    setPlan(prev => ({...prev, [key]: { ...prev[key], completed: !prev[key].completed }}));
                }
            };

            const updateItemField = (blockId, itemId, field, value, type) => {
                let setter, list;
                if (type === 'fuerza') { setter = setExercises; list = exercises; }
                else if (type === 'cuerda') { setter = setRopeBlocks; list = ropeBlocks; }
                else if (type === 'natacion') { setter = setSwimBlocks; list = swimBlocks; }
                
                const newList = list.map(block => {
                    if (block.id !== blockId) return block;
                    return { ...block, items: block.items.map(item => item.id !== itemId ? item : { ...item, [field]: value }) };
                });
                setter(newList);
            };

            const deleteBlock = (id, listType) => {
                if (listType === 'carrera') setIntervals(intervals.filter(i => i.id !== id));
                if (listType === 'fuerza') setExercises(exercises.filter(i => i.id !== id));
                if (listType === 'natacion') setSwimBlocks(swimBlocks.filter(i => i.id !== id));
                if (listType === 'cuerda') setRopeBlocks(ropeBlocks.filter(i => i.id !== id));
            };

            const getSessionTheme = (type) => {
                switch (type) {
                    case 'carrera': return { bg: 'bg-orange-50', border: 'border-orange-200', accent: 'text-orange-500', iconBg: 'bg-orange-100', icon: <Zap size={20}/> };
                    case 'fuerza': return { bg: 'bg-orange-50', border: 'border-orange-200', accent: 'text-orange-500', iconBg: 'bg-orange-100', icon: <Dumbbell size={20}/> };
                    case 'natacion': return { bg: 'bg-orange-50', border: 'border-orange-200', accent: 'text-orange-500', iconBg: 'bg-orange-100', icon: <Waves size={20}/> };
                    case 'cuerda': return { bg: 'bg-orange-50', border: 'border-orange-200', accent: 'text-orange-500', iconBg: 'bg-orange-100', icon: <Timer size={20}/> };
                    default: return { bg: 'bg-gray-100', border: 'border-gray-200', accent: 'text-gray-500', iconBg: 'bg-gray-200', icon: <Moon size={20}/> };
                }
            };

            const getYoutubeVideoId = (url) => {
                if (!url) return null;
                try {
                    const regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|shorts\/|watch\?v=|\&v=)([^#\&\?]*).*/;
                    const match = url.match(regExp);
                    if (match && match[2].length === 11) return match[2];
                    if (url.length === 11) return url;
                } catch (e) {}
                return null;
            };

            const handleVideoUpload = (e) => {
                const file = e.target.files[0];
                if (file) {
                    setVbtVideoUrl(URL.createObjectURL(file));
                    setVbtStartTime(null);
                    setVbtEndTime(null);
                    setIsDetectingFps(true);

                    if (typeof window.Log !== 'undefined') {
                        window.Log.error = () => {}; window.Log.warn = () => {}; window.Log.info = () => {}; window.Log.debug = () => {};
                    }

                    if (window.MP4Box && file.size <= 100 * 1024 * 1024) {
                        const mp4boxfile = MP4Box.createFile();
                        mp4boxfile.onReady = (info) => {
                            if (info.videoTracks && info.videoTracks.length > 0) {
                                const videoTrack = info.videoTracks[0];
                                if (videoTrack.nb_samples && videoTrack.duration) {
                                    const fps = Math.round(videoTrack.nb_samples / (videoTrack.duration / videoTrack.timescale));
                                    const std = [24, 25, 30, 50, 60, 120, 240];
                                    const closest = std.reduce((prev, curr) => Math.abs(curr - fps) < Math.abs(prev - fps) ? curr : prev);
                                    setVbtFps(closest.toString());
                                }
                            }
                            setIsDetectingFps(false);
                        };
                        mp4boxfile.onError = () => { setVbtFps('60'); setIsDetectingFps(false); };
                        
                        const reader = new FileReader();
                        reader.onload = (evt) => {
                            const buffer = evt.target.result;
                            buffer.fileStart = 0;
                            try { mp4boxfile.appendBuffer(buffer); mp4boxfile.flush(); } 
                            catch (err) { setVbtFps('60'); setIsDetectingFps(false); }
                        };
                        reader.onerror = () => { setVbtFps('60'); setIsDetectingFps(false); };
                        reader.readAsArrayBuffer(file);
                    } else { setVbtFps('60'); setIsDetectingFps(false); }
                }
            };
            
            const markTime = (type) => {
                if (videoRef.current) {
                    if (type === 'start') setVbtStartTime(videoRef.current.currentTime);
                    if (type === 'end') setVbtEndTime(videoRef.current.currentTime);
                }
            };
            
            const handleStepFrame = (direction) => {
                if (videoRef.current) {
                    const fps = parseFloat(vbtFps) || 60;
                    videoRef.current.currentTime += direction * (1 / fps);
                }
            };
            
            const vbtTime = (vbtStartTime !== null && vbtEndTime !== null && vbtEndTime > vbtStartTime) ? (vbtEndTime - vbtStartTime) : 0;
            const vbtVelocity = vbtTime > 0 ? (parseFloat(vbtRom) / 100) / vbtTime : 0;
            
            const calculateVbt1Rm = () => {
                if (vbtVelocity <= 0 || !vbtWeight) return 0;
                let percent1Rm = 0;
                const v = vbtVelocity;
                if (vbtExercise === 'sentadilla') percent1Rm = 100 - (v - 0.32) * 66.6;
                else if (vbtExercise === 'banca') percent1Rm = 100 - (v - 0.18) * 57.1;
                else if (vbtExercise === 'muerto') percent1Rm = 100 - (v - 0.14) * 66.6;
                else if (vbtExercise === 'dominadas') percent1Rm = 100 - (v - 0.22) * 57.1;
                
                if (percent1Rm > 100) percent1Rm = 100;
                if (percent1Rm < 30) percent1Rm = 30;
                return parseFloat(vbtWeight) / (percent1Rm / 100);
            };

            const currentVbt1Rm = calculateVbt1Rm();
            const effectiveVbt1Rm = currentVbt1Rm > 0 ? currentVbt1Rm : (saved1RMs[vbtExercise] || 0);
            const vbtTheoreticalReps = parseInt(vbtTargetReps) + Math.max(0, 10 - parseFloat(vbtTargetRpe));
            const recommendedVbtWeight = (effectiveVbt1Rm > 0 && vbtTheoreticalReps > 0) ? effectiveVbt1Rm / (1 + (vbtTheoreticalReps - 1) / 30) : 0;

            const handleAddTest = () => {
                const newTest = { id: Math.random().toString(), name: '', records: [] };
                setCustomTests([newTest, ...customTests]);
            };

            const updateTestName = (id, name) => {
                setCustomTests(customTests.map(t => t.id === id ? { ...t, name } : t));
            };

            const deleteTest = (id) => {
                setCustomTests(customTests.filter(t => t.id !== id));
            };

            const handleAddRecord = (testId) => {
                const dateInput = document.getElementById(`date-${testId}`).value;
                const valInput = document.getElementById(`val-${testId}`).value;
                if(!dateInput || !valInput) return;

                setCustomTests(customTests.map(t => {
                    if(t.id === testId) {
                        return { ...t, records: [...t.records, { id: Math.random().toString(), date: dateInput, value: valInput }] };
                    }
                    return t;
                }));
                document.getElementById(`val-${testId}`).value = ''; 
            };

            const deleteRecord = (testId, recordId) => {
                setCustomTests(customTests.map(t => {
                    if(t.id === testId) return { ...t, records: t.records.filter(r => r.id !== recordId) };
                    return t;
                }));
            };

            const calendarMap = React.useMemo(() => {
                const map = {};
                Object.keys(plan).forEach(key => {
                    const parts = key.split('-');
                    let year, week, dayStr;
                    if (parts.length === 3) {
                        year = parseInt(parts[0]); week = parseInt(parts[1]); dayStr = parts[2];
                    } else if (parts.length === 2) {
                        year = selectedYear; week = parseInt(parts[0]); dayStr = parts[1];
                    } else return;

                    const dayIdx = days.indexOf(dayStr);
                    if (dayIdx !== -1) {
                        const date = getExactDate(year, week, dayIdx);
                        const dateStr = `${date.getFullYear()}-${String(date.getMonth()+1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
                        map[dateStr] = plan[key];
                    }
                });
                return map;
            }, [plan, selectedYear]);

            const renderWeekSelector = () => {
                const weeksInMeso = [startWeek, startWeek + 1, startWeek + 2, startWeek + 3];
                const dateRange = getMesocycleDates(selectedYear, currentMesocycle);

                return (
                    <div className="space-y-4 mb-8">
                        <div className="flex items-center justify-between px-2">
                            <div className="flex items-center gap-2">
                                <Trophy size={16} className="text-orange-500" />
                                <span className="text-[12px] font-bold uppercase text-gray-500 tracking-widest">Planificación</span>
                                <select 
                                    value={selectedYear} 
                                    onChange={(e) => setSelectedYear(parseInt(e.target.value))}
                                    className="bg-transparent border-none text-[12px] font-bold text-orange-500 outline-none cursor-pointer appearance-none px-1"
                                >
                                    {[...Array(100)].map((_, i) => {
                                        const y = 2010 + i;
                                        return <option key={y} value={y}>{y}</option>;
                                    })}
                                </select>
                            </div>
                            <div className="flex items-center gap-3 bg-white p-1.5 rounded-xl border border-gray-200 shadow-sm">
                                <button onClick={handlePrevMeso} className={`p-2 rounded-md transition-colors active:scale-90 ${currentMesocycle > 1 ? 'active:bg-gray-100 text-gray-900' : 'text-gray-300'}`}><ChevronLeft size={18} /></button>
                                <div className="flex flex-col items-center justify-center px-1">
                                    <span className="text-[12px] font-black text-gray-900 min-w-[90px] text-center uppercase tracking-tighter">MESOCICLO {currentMesocycle}</span>
                                    <span className="text-[10px] font-bold text-orange-500 mt-0.5 tracking-wider">{dateRange}</span>
                                </div>
                                <button onClick={handleNextMeso} className="p-2 rounded-md active:bg-gray-100 text-gray-900 active:scale-90 transition-all"><ChevronRight size={18} /></button>
                            </div>
                        </div>
                        <div className="flex items-center gap-2.5 overflow-x-auto pb-2 no-scrollbar px-1" ref={weekScrollRef}>
                            {weeksInMeso.map(w => {
                                const isActive = currentWeek === w;
                                const sessionsCount = days.filter(d => plan[`${selectedYear}-${w}-${d}`] || plan[`${w}-${d}`]).length;

                                return (
                                    <button key={w} onClick={() => setCurrentWeek(w)} className={`flex-shrink-0 w-[78px] py-3 px-1 rounded-xl border transition-all duration-300 active:scale-95 flex flex-col items-center gap-1 ${isActive ? 'bg-orange-500 border-orange-500 text-white shadow-md shadow-orange-500/20' : 'bg-white border-gray-200 text-gray-500 shadow-sm'}`}>
                                        <span className={`text-[9px] font-black uppercase tracking-widest ${isActive ? 'text-orange-100' : 'text-gray-400'}`}>Semana</span>
                                        <span className={`text-2xl font-black ${isActive ? 'text-white' : 'text-gray-900'}`}>{w}</span>
                                        <div className="flex gap-1 mt-1">
                                            {[...Array(7)].map((_, i) => (
                                                <div key={i} className={`w-1.5 h-1.5 rounded-full ${i < sessionsCount ? (isActive ? 'bg-white' : 'bg-orange-500') : (isActive ? 'bg-orange-400' : 'bg-gray-200')}`} />
                                            ))}
                                        </div>
                                    </button>
                                );
                            })}
                        </div>
                    </div>
                );
            };

            return (
                <div className={`min-h-screen bg-gray-50 text-gray-600 transition-all duration-300 font-sans`}>
                    
                    {/* Overlay y Menú Lateral (Sidebar) */}
                    {isMenuOpen && (
                        <div 
                            className="fixed inset-0 bg-gray-900/40 backdrop-blur-sm z-[150] transition-opacity duration-300" 
                            onClick={() => setIsMenuOpen(false)}
                        />
                    )}
                    
                    <div className={`fixed top-0 left-0 h-full w-72 bg-white z-[160] shadow-2xl transform transition-transform duration-300 ease-in-out ${isMenuOpen ? 'translate-x-0' : '-translate-x-full'} flex flex-col`}>
                        <div className="p-6 border-b border-gray-100 flex items-center justify-between pt-[max(2rem,env(safe-area-inset-top))]">
                            <div className="flex items-center gap-3">
                                <div className="w-10 h-10 bg-orange-500 rounded-xl flex items-center justify-center shadow-md shadow-orange-500/20">
                                    <SamuraiFireHelmet size={20} className="text-white" />
                                </div>
                                <h2 className="text-xl font-black tracking-tighter text-gray-900">MENÚ</h2>
                            </div>
                            <button onClick={() => setIsMenuOpen(false)} className="p-2 -mr-2 text-gray-400 hover:text-gray-900 active:bg-gray-100 rounded-full transition-all">
                                <X size={20} />
                            </button>
                        </div>
                        
                        <nav className="flex-1 overflow-y-auto py-5 px-4 space-y-2">
                            {[
                                { id: 'calendario', icon: <Calendar size={22} />, label: 'Editor de Entrenamiento' },
                                { id: 'resumen', icon: <FileText size={22} />, label: 'Entrenamiento' },
                                { id: 'herramientas', icon: <Calculator size={22} />, label: 'Herramientas' },
                                { id: 'perfil', icon: <User size={22} />, label: 'Perfil' },
                            ].map(item => (
                                <button 
                                    key={item.id} 
                                    onClick={() => { setActiveTab(item.id); setIsMenuOpen(false); }}
                                    className={`w-full flex items-center gap-4 px-4 py-4 rounded-xl transition-all active:scale-[0.98] ${activeTab === item.id ? 'bg-orange-50 text-orange-500 font-bold shadow-sm border border-orange-100' : 'text-gray-500 font-medium hover:bg-gray-50'}`}
                                >
                                    <div className={`${activeTab === item.id ? 'text-orange-500' : 'text-gray-400'}`}>
                                        {item.icon}
                                    </div>
                                    <span className="text-[15px] uppercase tracking-widest">{item.label}</span>
                                </button>
                            ))}
                        </nav>
                        
                        <div className="p-5 border-t border-gray-100 pb-[max(1rem,env(safe-area-inset-bottom))]">
                            <button onClick={() => { setIsMenuOpen(false); setShowExitConfirm(true); }} className="w-full flex items-center justify-center gap-2 py-4 rounded-[14px] text-gray-500 font-black uppercase text-[13px] tracking-widest hover:bg-gray-50 active:bg-gray-100 transition-all border border-gray-200">
                                <Logout size={16} /> Cerrar App
                            </button>
                        </div>
                    </div>

                    {/* Header */}
                    <header className={`sticky top-0 z-40 backdrop-blur-xl border-b bg-white/90 border-gray-200 px-6 pt-[max(1rem,env(safe-area-inset-top))] pb-4`}>
                        <div className="max-w-xl mx-auto flex justify-between items-center">
                            <div className="flex items-center gap-3">
                                <button onClick={() => setIsMenuOpen(true)} className="p-2 -ml-2 text-gray-500 hover:text-gray-900 active:bg-gray-100 rounded-lg transition-all flex-shrink-0">
                                    <Menu size={22} />
                                </button>
                                <div className="w-10 h-10 bg-orange-500 rounded-xl flex items-center justify-center shadow-lg shadow-orange-500/20">
                                    <SamuraiFireHelmet size={22} className="text-white" />
                                </div>
                                <h1 className="text-2xl font-black tracking-tighter text-gray-900">SPRINT <span className="text-orange-500">&amp;</span> RELAX</h1>
                            </div>
                            <button onClick={() => setShowExitConfirm(true)} className="w-10 h-10 flex items-center justify-center rounded-full bg-gray-100 border border-gray-200 text-gray-500 hover:text-gray-900 active:scale-90 transition-all">
                                <Logout size={16} />
                            </button>
                        </div>
                    </header>

                    {/* Modal Confirmación de Salida */}
                    {showExitConfirm && (
                        <div className="fixed inset-0 z-[120] bg-gray-900/40 backdrop-blur-sm flex flex-col items-center justify-center p-4 animate-in fade-in duration-300">
                            <div className="bg-white border border-gray-200 rounded-[24px] p-6 w-full max-w-sm shadow-2xl text-center relative overflow-hidden">
                                <div className="absolute top-0 left-0 w-full h-1.5 bg-orange-500"></div>
                                <div className="w-16 h-16 bg-red-50 rounded-full flex items-center justify-center mx-auto mb-4 border border-red-100">
                                    <Logout size={26} className="text-red-500" />
                                </div>
                                <h3 className="text-2xl font-black text-gray-900 uppercase tracking-tight mb-2">¿Salir de la App?</h3>
                                <p className="text-[14px] text-gray-500 mb-6">Tu progreso está guardado automáticamente.</p>
                                <div className="flex gap-3">
                                    <button onClick={() => setShowExitConfirm(false)} className="flex-1 py-4 rounded-[14px] bg-gray-100 text-gray-900 font-black uppercase text-[13px] tracking-widest border border-gray-200 active:scale-95 transition-all">Cancelar</button>
                                    <button onClick={() => {
                                        if (window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone) window.close();
                                        else window.location.href = "about:blank";
                                    }} className="flex-1 py-4 rounded-[14px] bg-red-500 text-white font-black uppercase text-[13px] tracking-widest active:scale-95 transition-all shadow-md shadow-red-500/20">Salir</button>
                                </div>
                            </div>
                        </div>
                    )}

                    <main className="max-w-xl mx-auto px-5 mt-6 pb-32">
                        
                        {/* ================= PESTAÑA CALENDARIO ================= */}
                        {activeTab === 'calendario' && (
                            <div className="space-y-4 animate-in fade-in duration-500">
                                {renderWeekSelector()}
                                <div className="flex items-center gap-2 mb-4 px-1 mt-6">
                                    <Activity size={14} className="text-orange-500" />
                                    <span className="text-[12px] font-black uppercase text-gray-400 tracking-[0.2em]">Sesiones diarias</span>
                                </div>
                                {days.map((day, index) => {
                                    const session = plan[`${selectedYear}-${currentWeek}-${day}`] || plan[`${currentWeek}-${day}`];
                                    const isRest = session?.type === 'descanso';
                                    const exactDate = getExactDate(selectedYear, currentWeek, index);
                                    const dayNum = exactDate.getDate();
                                    const monthStr = exactDate.toLocaleDateString('es-ES', { month: 'short' }).replace('.', '').toUpperCase();

                                    return (
                                        <div key={day} onClick={() => openEditor(selectedYear, currentWeek, day)} className={`group active:scale-[0.98] cursor-pointer p-4 rounded-2xl border transition-transform duration-200 shadow-sm ${session ? (isRest ? 'bg-gray-50 border-gray-200' : 'bg-white border-orange-200') : 'bg-white border-gray-200 active:border-orange-300'}`}>
                                            <div className="flex justify-between items-center">
                                                <div className="flex items-center gap-4 min-w-0">
                                                    <div className={`flex-shrink-0 w-14 h-14 rounded-[14px] flex items-center justify-center ${session ? (isRest ? 'bg-gray-100 text-gray-400' : 'bg-orange-500 text-white shadow-md shadow-orange-500/20') : 'bg-gray-100 text-gray-400'}`}>
                                                        {session?.type === 'carrera' ? <Zap size={24}/> : session?.type === 'fuerza' ? <Dumbbell size={24}/> : session?.type === 'natacion' ? <Waves size={24}/> : session?.type === 'descanso' ? <Moon size={24}/> : <Timer size={24}/>}
                                                    </div>
                                                    <div className="min-w-0 pr-2">
                                                        <span className="text-[12px] font-black uppercase text-gray-400 tracking-widest whitespace-nowrap">{day} · {dayNum} {monthStr}</span>
                                                        <h3 className={`text-[17px] font-bold mt-1 leading-tight truncate ${session ? (isRest ? 'text-gray-500 italic' : 'text-gray-900') : 'text-gray-400'}`}>{session ? session.name : 'Configurar sesión'}</h3>
                                                    </div>
                                                </div>
                                                {session ? <CheckCircle2 size={22} className={`flex-shrink-0 ${isRest ? "text-gray-300" : "text-orange-500"}`} /> : <Plus size={22} className="text-gray-300 flex-shrink-0" />}
                                            </div>
                                        </div>
                                    );
                                })}
                            </div>
                        )}

                        {/* ================= PESTAÑA EDITOR ================= */}
                        {activeTab === 'editor' && (
                            <div className="space-y-6 animate-in slide-in-from-right-4 duration-300 pb-32">
                                <div className="flex items-center justify-between mb-2">
                                    <div className="flex items-center gap-2">
                                        <button onClick={() => { setEditingDay(null); setActiveTab('calendario'); }} className="flex items-center gap-2 p-2 -ml-2 text-gray-500 text-[13px] font-black uppercase tracking-widest active:text-orange-500 active:bg-orange-50 rounded-lg transition-all"><ArrowLeft size={18}/> Volver</button>
                                        {(plan[`${editingDay?.year}-${editingDay?.week}-${editingDay?.day}`] || plan[`${editingDay?.week}-${editingDay?.day}`]) && (
                                            <button onClick={deleteSession} className="flex items-center gap-1.5 p-2 text-red-500/80 hover:text-red-500 text-[13px] font-black uppercase tracking-widest active:bg-red-50 rounded-lg transition-all">
                                                <Trash2 size={16}/> Borrar
                                            </button>
                                        )}
                                    </div>
                                    <div className="text-right">
                                        <span className="text-[11px] font-black text-gray-400 uppercase block tracking-widest mb-0.5">{editingDay?.year} · Meso {currentMesocycle}</span>
                                        <span className="text-[12px] font-black text-orange-500 uppercase tracking-tighter">
                                            {editingDay?.day} {editingDay ? getExactDate(editingDay.year, editingDay.week, days.indexOf(editingDay.day)).getDate() : ''} {editingDay ? getExactDate(editingDay.year, editingDay.week, days.indexOf(editingDay.day)).toLocaleDateString('es-ES', { month: 'short' }).replace('.', '').toUpperCase() : ''} · SEMANA {editingDay?.week}
                                        </span>
                                    </div>
                                </div>

                                <div className="grid grid-cols-5 gap-1 p-1.5 bg-white shadow-sm rounded-[18px] border border-gray-200">
                                    {[
                                        { id: 'carrera', icon: <Zap size={20}/> },
                                        { id: 'fuerza', icon: <Dumbbell size={20}/> },
                                        { id: 'natacion', icon: <Waves size={20}/> },
                                        { id: 'cuerda', icon: <Timer size={20}/> },
                                        { id: 'descanso', icon: <Moon size={20}/> }
                                    ].map(type => (
                                        <button key={type.id} onClick={() => setSessionType(type.id)} className={`flex flex-col items-center gap-1.5 py-3 rounded-[14px] text-[11px] font-black uppercase transition-all active:scale-95 ${sessionType === type.id ? 'bg-orange-500 text-white shadow-md' : 'text-gray-400 hover:text-gray-600'}`}>
                                            {type.icon}
                                            {type.id === 'descanso' ? 'Desc' : type.id}
                                        </button>
                                    ))}
                                </div>

                                {sessionType !== 'descanso' ? (
                                    <>
                                        <div className="space-y-5 mt-4">
                                            {sessionType === 'carrera' && (
                                                <div className="space-y-4">
                                                    <div className="flex gap-2">
                                                        {['rodaje', 'fartlek', 'series'].map(st => (
                                                            <button key={st} onClick={() => setIntervals([...intervals, { id: Math.random(), subType: st, notas: '', distancia: st === 'series' ? '10x400m' : '10', ritmo: '4:30', reps: '10', tiempoFuerte: '1:00', tiempoSuave: '1:00', vamPct: '100', descanso: '1:30' }])} className="flex-1 py-4 rounded-[14px] bg-orange-50 border border-orange-200 text-[12px] font-black uppercase text-orange-500 active:bg-orange-500 active:text-white transition-all shadow-sm">+ {st}</button>
                                                        ))}
                                                    </div>
                                                    {intervals.map(int => (
                                                        <div key={int.id} className="p-5 rounded-[20px] bg-white shadow-sm border border-gray-200 relative">
                                                            <button onClick={() => deleteBlock(int.id, 'carrera')} className="absolute top-5 right-5 p-2 -mr-2 -mt-2 text-gray-400 active:text-red-500 active:bg-red-50 rounded-lg transition-all"><Trash2 size={18}/></button>
                                                            <span className="text-[12px] font-black text-orange-500 uppercase tracking-[0.2em] block mb-5">{int.subType}</span>
                                                            <div className="grid grid-cols-3 gap-3 mb-4">
                                                                {int.subType === 'rodaje' ? (
                                                                    <>
                                                                        <div className="space-y-1.5"><label className="text-[10px] font-black uppercase text-gray-400 tracking-widest">KM</label><input inputMode="decimal" className="w-full bg-gray-50 border border-gray-200 rounded-[14px] p-4 text-[17px] font-bold text-gray-900 focus:border-orange-500 focus:outline-none" value={int.distancia} onChange={e => setIntervals(intervals.map(i => i.id === int.id ? {...i, distancia: e.target.value} : i))}/></div>
                                                                        <div className="space-y-1.5"><label className="text-[10px] font-black uppercase text-gray-400 tracking-widest">Ritmo</label><input inputMode="text" className="w-full bg-gray-50 border border-gray-200 rounded-[14px] p-4 text-[17px] font-bold text-gray-900 focus:border-orange-500 focus:outline-none" value={int.ritmo} onChange={e => setIntervals(intervals.map(i => i.id === int.id ? {...i, ritmo: e.target.value} : i))}/></div>
                                                                    </>
                                                                ) : int.subType === 'fartlek' ? (
                                                                    <>
                                                                        <div className="space-y-1.5"><label className="text-[10px] font-black uppercase text-gray-400 tracking-widest">Reps</label><input inputMode="numeric" className="w-full bg-gray-50 border border-gray-200 rounded-[14px] p-4 text-[17px] font-bold text-gray-900 focus:border-orange-500 focus:outline-none" value={int.reps} onChange={e => setIntervals(intervals.map(i => i.id === int.id ? {...i, reps: e.target.value} : i))}/></div>
                                                                        <div className="space-y-1.5">
                                                                            <label className="text-[10px] font-black uppercase text-gray-400 tracking-widest">Fuerte + Suave</label>
                                                                            <div className="flex items-center gap-1.5">
                                                                                <input inputMode="text" className="w-full bg-gray-50 border border-gray-200 rounded-[14px] p-4 text-[17px] font-bold text-gray-900 text-center px-1 focus:border-orange-500 focus:outline-none" value={int.tiempoFuerte} onChange={e => setIntervals(intervals.map(i => i.id === int.id ? {...i, tiempoFuerte: e.target.value} : i))} placeholder="F"/>
                                                                                <span className="text-gray-400 font-black text-xl">+</span>
                                                                                <input inputMode="text" className="w-full bg-gray-50 border border-gray-200 rounded-[14px] p-4 text-[17px] font-bold text-gray-900 text-center px-1 focus:border-orange-500 focus:outline-none" value={int.tiempoSuave} onChange={e => setIntervals(intervals.map(i => i.id === int.id ? {...i, tiempoSuave: e.target.value} : i))} placeholder="S"/>
                                                                            </div>
                                                                        </div>
                                                                    </>
                                                                ) : (
                                                                    <>
                                                                        <div className="space-y-1.5"><label className="text-[10px] font-black uppercase text-gray-400 tracking-widest">Series (Libre)</label><input type="text" placeholder="Ej: 10x400m, 5x3'" className="w-full bg-gray-50 border border-gray-200 rounded-[14px] p-4 text-[17px] font-bold text-gray-900 focus:border-orange-500 focus:outline-none" value={int.formatoLibre || (int.reps && int.distancia && !String(int.distancia).includes('x') && !isNaN(int.distancia) ? `${int.reps}x${int.distancia}m` : int.distancia)} onChange={e => setIntervals(intervals.map(i => i.id === int.id ? {...i, distancia: e.target.value, formatoLibre: e.target.value} : i))}/></div>
                                                                        <div className="space-y-1.5"><label className="text-[10px] font-black uppercase text-gray-400 tracking-widest">% VAM</label><input inputMode="numeric" className="w-full bg-gray-50 border border-gray-200 rounded-[14px] p-4 text-[17px] text-orange-500 font-black focus:border-orange-500 focus:outline-none" value={int.vamPct} onChange={e => setIntervals(intervals.map(i => i.id === int.id ? {...i, vamPct: e.target.value} : i))}/></div>
                                                                        <div className="space-y-1.5"><label className="text-[10px] font-black uppercase text-gray-400 tracking-widest">Rec</label><input inputMode="text" className="w-full bg-gray-50 border border-gray-200 rounded-[14px] p-4 text-[17px] font-bold text-gray-900 focus:border-orange-500 focus:outline-none" value={int.descanso} onChange={e => setIntervals(intervals.map(i => i.id === int.id ? {...i, descanso: e.target.value} : i))}/></div>
                                                                    </>
                                                                )}
                                                            </div>
                                                            <div className="space-y-1.5 bg-gray-50 p-4 rounded-[16px] border border-gray-200 focus-within:border-orange-300 transition-colors">
                                                                <label className="text-[10px] font-black uppercase text-gray-500 flex items-center gap-1.5 mb-1"><StickyNote size={14} className="text-orange-500"/> Notas</label>
                                                                <textarea className="w-full bg-transparent text-base font-medium resize-none focus:outline-none text-gray-700" rows="2" value={int.notas} onChange={e => setIntervals(intervals.map(i => i.id === int.id ? {...i, notas: e.target.value} : i))} />
                                                            </div>
                                                        </div>
                                                    ))}
                                                </div>
                                            )}

                                            {(sessionType === 'fuerza' || sessionType === 'cuerda' || sessionType === 'natacion') && (
                                                <div className="space-y-6">
                                                    <button onClick={() => {
                                                        const newBlock = { id: Math.random(), descansoSerie: sessionType === 'natacion' ? '0:20' : '1:30', items: [{ id: Math.random(), nombre: '', videoUrl: '', series: '3', reps: sessionType === 'natacion' ? '100m' : '12', rpe: '7', ritmo: sessionType === 'natacion' ? '1:45' : '', notas: '' }] };
                                                        const setter = sessionType === 'fuerza' ? setExercises : sessionType === 'natacion' ? setSwimBlocks : setRopeBlocks;
                                                        const list = sessionType === 'fuerza' ? exercises : sessionType === 'natacion' ? swimBlocks : ropeBlocks;
                                                        setter([...list, newBlock]);
                                                    }} className={`w-full py-5 border-2 border-dashed border-gray-300 rounded-[20px] text-[12px] font-black uppercase text-gray-500 active:bg-orange-50 active:text-orange-500 active:border-orange-300 transition-all`}>
                                                        + Añadir Bloque {sessionType}
                                                    </button>
                                                    
                                                    {(sessionType === 'fuerza' ? exercises : sessionType === 'natacion' ? swimBlocks : ropeBlocks).map((block, bIdx) => (
                                                        <div key={block.id} className={`p-5 rounded-[24px] border space-y-4 bg-white border-gray-200 shadow-sm`}>
                                                            <div className="flex justify-between items-center mb-1">
                                                                <span className={`text-[12px] font-black uppercase tracking-[0.2em] text-orange-500`}>BLOQUE {bIdx+1}</span>
                                                                <div className="flex gap-3 items-center">
                                                                    <div className="flex items-center gap-1.5 px-3 py-2 rounded-full bg-gray-100 border border-gray-200">
                                                                        <Clock size={14} className="text-gray-500"/>
                                                                        <input inputMode="text" className="bg-transparent border-none p-0 text-[13px] w-14 font-black text-center text-gray-900 focus:outline-none" value={block.descansoSerie} onChange={e => {
                                                                            const setter = sessionType === 'fuerza' ? setExercises : sessionType === 'natacion' ? setSwimBlocks : setRopeBlocks;
                                                                            const list = sessionType === 'fuerza' ? exercises : sessionType === 'natacion' ? swimBlocks : ropeBlocks;
                                                                            setter(list.map(b => b.id === block.id ? {...b, descansoSerie: e.target.value} : b));
                                                                        }}/>
                                                                    </div>
                                                                    <button onClick={() => deleteBlock(block.id, sessionType)} className="p-2 -mr-2 text-gray-400 active:text-red-500 active:bg-red-50 rounded-full transition-all"><Trash2 size={18} /></button>
                                                                </div>
                                                            </div>

                                                            {block.items.map((item, iIdx) => (
                                                                <div key={item.id} className="bg-gray-50 p-4 rounded-[18px] border border-gray-200 relative focus-within:border-orange-300 transition-colors">
                                                                    <button onClick={() => {
                                                                        const setter = sessionType === 'fuerza' ? setExercises : sessionType === 'natacion' ? setSwimBlocks : setRopeBlocks;
                                                                        const list = sessionType === 'fuerza' ? exercises : sessionType === 'natacion' ? swimBlocks : ropeBlocks;
                                                                        setter(list.map(b => b.id === block.id ? {...b, items: b.items.filter(e => e.id !== item.id)} : b));
                                                                    }} className="absolute top-3 right-3 p-2 -mt-1 -mr-1 text-gray-400 active:bg-gray-200 rounded-full transition-all"><X size={16} /></button>
                                                                    
                                                                    <div className="flex flex-col gap-2 mb-4">
                                                                        <input placeholder={sessionType === 'natacion' ? "Ejercicio de nado" : "Nombre del ejercicio"} className="w-full bg-transparent text-[17px] font-black border-none outline-none text-gray-900 placeholder-gray-400 tracking-tight pr-8" value={item.nombre} onChange={e => updateItemField(block.id, item.id, 'nombre', e.target.value, sessionType)}/>
                                                                        <div className="flex items-center gap-2 bg-white px-3 py-2.5 rounded-[12px] border border-gray-200 focus-within:border-orange-300 transition-colors">
                                                                            <Youtube size={14} className="text-red-500" />
                                                                            <input placeholder="URL del vídeo de YouTube (Opcional)" className="bg-transparent w-full text-[13px] outline-none text-gray-700 placeholder-gray-400" value={item.videoUrl || ''} onChange={e => updateItemField(block.id, item.id, 'videoUrl', e.target.value, sessionType)} />
                                                                        </div>
                                                                    </div>

                                                                    <div className="grid grid-cols-3 gap-2.5">
                                                                        <div className="bg-white border border-gray-200 p-2.5 rounded-[12px] text-center focus-within:border-orange-300"><label className="text-[10px] uppercase font-black text-gray-400 block mb-1">Series</label><input inputMode="numeric" className="bg-transparent text-center w-full text-base font-bold text-gray-900 focus:outline-none" value={item.series} onChange={e => updateItemField(block.id, item.id, 'series', e.target.value, sessionType)}/></div>
                                                                        <div className="bg-white border border-gray-200 p-2.5 rounded-[12px] text-center focus-within:border-orange-300"><label className="text-[10px] uppercase font-black text-gray-400 block mb-1">{sessionType === 'natacion' ? 'Metros' : 'Reps'}</label><input inputMode="text" className="bg-transparent text-center w-full text-base font-bold text-gray-900 focus:outline-none" value={item.reps} onChange={e => updateItemField(block.id, item.id, 'reps', e.target.value, sessionType)}/></div>
                                                                        {sessionType === 'natacion' ? (
                                                                            <div className="bg-orange-50 p-2.5 rounded-[12px] text-center border border-orange-200 focus-within:border-orange-400"><label className="text-[10px] uppercase font-black text-orange-500 block mb-1">Ritmo</label><input inputMode="text" className="bg-transparent text-center w-full text-base font-black text-orange-600 focus:outline-none" value={item.ritmo} onChange={e => updateItemField(block.id, item.id, 'ritmo', e.target.value, sessionType)}/></div>
                                                                        ) : (
                                                                            <div className="bg-orange-50 p-2.5 rounded-[12px] text-center border border-orange-200 focus-within:border-orange-400"><label className="text-[10px] uppercase font-black text-orange-500 block mb-1">RPE</label><input inputMode="numeric" className="bg-transparent text-center w-full text-base font-black text-orange-600 focus:outline-none" value={item.rpe} onChange={e => updateItemField(block.id, item.id, 'rpe', e.target.value, sessionType)}/></div>
                                                                        )}
                                                                    </div>
                                                                    <textarea placeholder="Notas adicionales..." className="w-full bg-white border border-gray-200 p-4 rounded-[12px] text-sm mt-3 resize-none outline-none focus:border-orange-300 text-gray-700 placeholder-gray-400" rows="1" value={item.notas} onChange={e => updateItemField(block.id, item.id, 'notas', e.target.value, sessionType)} />
                                                                </div>
                                                            ))}
                                                            <button onClick={() => {
                                                                const setter = sessionType === 'fuerza' ? setExercises : sessionType === 'natacion' ? setSwimBlocks : setRopeBlocks;
                                                                const list = sessionType === 'fuerza' ? exercises : sessionType === 'natacion' ? swimBlocks : ropeBlocks;
                                                                setter(list.map(b => b.id === block.id ? { ...b, items: [...b.items, { id: Math.random(), nombre: '', videoUrl: '', series: '3', reps: sessionType === 'natacion' ? '100m' : '12', rpe: '7', ritmo: sessionType === 'natacion' ? '1:45' : '', notas: '' }] } : b));
                                                            }} className={`w-full py-4 bg-gray-100 active:bg-gray-200 rounded-[16px] text-[12px] font-black uppercase text-gray-500 transition-colors`}>+ Añadir Línea</button>
                                                        </div>
                                                    ))}
                                                </div>
                                            )}
                                        </div>
                                    </>
                                ) : (
                                    <div className="flex flex-col items-center justify-center py-20 bg-white rounded-[24px] border border-gray-300 border-dashed mt-10 shadow-sm">
                                        <Moon size={64} className="text-gray-300 mb-5" />
                                        <h3 className="text-2xl font-black text-gray-400 uppercase tracking-tighter">Día de recuperación</h3>
                                        <p className="text-[12px] font-bold text-gray-400 uppercase mt-3 tracking-[0.3em]">Cargando pilas para mañana</p>
                                    </div>
                                )}

                                <div className="fixed bottom-0 left-0 right-0 px-6 pt-6 pb-[max(2rem,env(safe-area-inset-bottom))] bg-gradient-to-t from-gray-50 via-gray-50/95 to-transparent pointer-events-none z-50">
                                    <button onClick={saveAndReturn} className="max-w-xl mx-auto w-full bg-orange-500 py-4.5 rounded-[18px] font-black text-[14px] uppercase tracking-[0.3em] text-white shadow-lg shadow-orange-500/30 pointer-events-auto flex items-center justify-center gap-3 active:bg-orange-600 active:scale-[0.98] transition-all h-[64px]">
                                        <Save size={20}/> {sessionType === 'descanso' ? 'Confirmar Descanso' : 'Guardar Sesión'}
                                    </button>
                                </div>
                            </div>
                        )}

                        {/* ================= PESTAÑA ENTRENAMIENTO ================= */}
                        {activeTab === 'resumen' && (
                            <div className="space-y-6 animate-in fade-in duration-500 pb-10">
                                {renderWeekSelector()}
                                <div className="text-center pt-2 pb-4">
                                    <h2 className="text-3xl font-black text-gray-900 uppercase tracking-tighter">Entrenamiento</h2>
                                    <div className="h-1.5 w-14 bg-orange-500 mx-auto mt-3 rounded-full shadow-md shadow-orange-500/20"></div>
                                </div>

                                <div className="space-y-6">
                                    {days.map((day, index) => {
                                        const session = plan[`${selectedYear}-${currentWeek}-${day}`] || plan[`${currentWeek}-${day}`];
                                        const isRest = session?.type === 'descanso';
                                        const theme = getSessionTheme(session?.type);
                                        const exactDate = getExactDate(selectedYear, currentWeek, index);
                                        const dayNum = exactDate.getDate();
                                        const monthStr = exactDate.toLocaleDateString('es-ES', { month: 'short' }).replace('.', '').toUpperCase();
                                        
                                        if (!session || isRest) return (
                                            <div key={day} className="flex justify-between items-center py-5 border-b border-gray-200">
                                                <div className="flex items-center gap-3 opacity-50">
                                                    <Moon size={20} className="text-gray-400" />
                                                    <span className="text-[13px] font-black uppercase tracking-[0.2em] text-gray-600">{day} · {dayNum} {monthStr}</span>
                                                </div>
                                                <span className="text-[12px] font-bold italic uppercase tracking-[0.3em] text-gray-400">Descanso</span>
                                            </div>
                                        );

                                        return (
                                            <div key={day} className={`pb-6 border-b border-gray-200 transition-all duration-300 ${session.completed ? 'opacity-60' : ''}`}>
                                                <div className="flex justify-between items-center cursor-pointer group" onClick={() => toggleSessionCompletion(selectedYear, currentWeek, day)}>
                                                    <div className="flex items-center gap-3">
                                                        <div className={`p-3 rounded-[12px] transition-colors ${session.completed ? 'bg-green-100 text-green-600' : `${theme.iconBg} ${theme.accent}`}`}>
                                                            {session.completed ? <CheckCircle2 size={20}/> : theme.icon}
                                                        </div>
                                                        <span className={`text-[13px] font-black uppercase tracking-[0.2em] transition-colors ${session.completed ? 'text-green-600' : theme.accent}`}>{day} · {dayNum} {monthStr}</span>
                                                    </div>
                                                    <div className="flex items-center gap-3">
                                                        <span className={`text-[17px] max-w-[140px] truncate md:max-w-xs font-black uppercase tracking-tight text-right leading-tight transition-all ${session.completed ? 'text-gray-400 line-through' : 'text-gray-900'}`}>{session.name}</span>
                                                        <button className="p-1 active:scale-90 transition-transform flex-shrink-0">
                                                            {session.completed ? 
                                                                <CheckCircle2 size={24} className="text-green-500" /> : 
                                                                <div className="w-[22px] h-[22px] rounded-full border-2 border-gray-300 group-hover:border-orange-500 transition-colors"></div>
                                                            }
                                                        </button>
                                                    </div>
                                                </div>
                                                
                                                {!session.completed && (
                                                    <div className="animate-in slide-in-from-top-2 fade-in duration-300 space-y-4 mt-4">
                                                        <div className="grid grid-cols-1 gap-3">
                                                            {session.data.map((block, bIdx) => (
                                                                <div key={bIdx} className={`p-5 rounded-[20px] border bg-white ${theme.border} space-y-4 shadow-sm`}>
                                                                    {session.type === 'carrera' && (
                                                                        <div className="space-y-3.5">
                                                                            <div className="flex justify-between text-[12px] font-black uppercase text-gray-500 tracking-widest border-b border-gray-100 pb-2.5">
                                                                                <span>BLOQUE {bIdx+1}</span>
                                                                                <span className={theme.accent}>Rec: {block.subType === 'series' ? block.descanso : (block.subType === 'fartlek' ? 'N/A' : 'S/R')}</span>
                                                                            </div>
                                                                            <div className="flex justify-between items-center">
                                                                                <span className="text-gray-900 font-black uppercase tracking-[0.15em] text-[13px]">{block.subType}</span>
                                                                                <span className={`font-black uppercase tracking-tighter text-[17px] text-right ${theme.accent}`}>
                                                                                    {block.subType === 'rodaje' ? `${block.distancia}km @ ${block.ritmo}` : 
                                                                                     block.subType === 'series' ? `${block.formatoLibre || (block.reps && block.distancia && !String(block.distancia).includes('x') && !isNaN(block.distancia) ? block.reps + 'x' + block.distancia + 'm' : block.distancia)} @ ${block.vamPct}% VAM` : 
                                                                                     `${block.reps} reps (${block.tiempoFuerte}/${block.tiempoSuave})`}
                                                                                </span>
                                                                            </div>
                                                                            {block.notas && <p className="text-[13px] text-gray-500 italic border-l-[3px] border-gray-200 pl-3 py-0.5 leading-relaxed">"{block.notas}"</p>}
                                                                        </div>
                                                                    )}

                                                                    {(session.type === 'fuerza' || session.type === 'cuerda' || session.type === 'natacion') && (
                                                                        <div className="space-y-3.5">
                                                                            <div className={`flex justify-between text-[12px] font-black uppercase text-gray-500 tracking-widest border-b border-gray-100 pb-2.5`}>
                                                                                <span>BLOQUE {bIdx+1}</span>
                                                                                <span className={theme.accent}>Rec: {block.descansoSerie}</span>
                                                                            </div>
                                                                            {block.items.map((item, eIdx) => (
                                                                                <div key={eIdx} className="space-y-1.5">
                                                                                    <div className="flex justify-between items-start gap-3">
                                                                                        <div className="flex items-center gap-2 flex-1 flex-wrap">
                                                                                            <span className="text-gray-900 font-bold uppercase tracking-tight text-[14px] leading-tight">{item.nombre || (session.type === 'natacion' ? 'Nado' : 'Ejercicio')}</span>
                                                                                            {item.videoUrl && (
                                                                                                <button 
                                                                                                    onClick={(e) => {
                                                                                                        e.stopPropagation();
                                                                                                        const videoId = getYoutubeVideoId(item.videoUrl);
                                                                                                        if (videoId) setActiveVideo(videoId);
                                                                                                    }} 
                                                                                                    className="text-red-500 hover:text-red-600 active:scale-90 transition-all flex items-center justify-center bg-red-50 p-1.5 rounded-md border border-red-100" 
                                                                                                    title="Ver vídeo en la app"
                                                                                                >
                                                                                                    <Youtube size={14} />
                                                                                                </button>
                                                                                            )}
                                                                                        </div>
                                                                                        <span className={`font-black uppercase tracking-widest text-[14px] whitespace-nowrap mt-0.5 ${theme.accent}`}>
                                                                                            {item.series}x{item.reps} 
                                                                                            {session.type === 'natacion' ? <span className="ml-1.5 text-gray-400">@{item.ritmo}</span> : (item.rpe && <span className="text-orange-500 ml-1.5">RPE {item.rpe}</span>)}
                                                                                        </span>
                                                                                    </div>
                                                                                    {item.notas && <p className="text-[13px] text-gray-500 italic pl-3 border-l-[3px] border-gray-200 py-0.5">"{item.notas}"</p>}
                                                                                </div>
                                                                            ))}
                                                                        </div>
                                                                    )}
                                                                </div>
                                                            ))}
                                                        </div>

                                                        <div className="mt-3 p-5 rounded-[18px] bg-white border border-gray-200 shadow-sm relative group focus-within:border-orange-300 focus-within:shadow-md transition-all duration-300">
                                                            <div className="flex items-center gap-2 mb-2">
                                                                <Pen size={14} className={theme.accent} />
                                                                <span className="text-[12px] font-black uppercase text-gray-500 tracking-widest">Diario del Atleta</span>
                                                            </div>
                                                            <textarea 
                                                                className="w-full bg-transparent text-base text-gray-900 placeholder-gray-400 focus:outline-none resize-none leading-relaxed"
                                                                rows="3"
                                                                placeholder="¿Cómo te sentiste hoy? Sensaciones, RPE general, molestias..."
                                                                value={session.notasAlumno || ''}
                                                                onChange={(e) => updateStudentNotes(selectedYear, currentWeek, day, e.target.value)}
                                                            />
                                                        </div>
                                                    </div>
                                                )}
                                            </div>
                                        );
                                    })}
                                </div>
                            </div>
                        )}

                        {/* ================= PESTAÑA HERRAMIENTAS ================= */}
                        {activeTab === 'herramientas' && (
                            <div className="space-y-6 animate-in fade-in duration-500 pb-10">
                                <div className="text-center pt-2 pb-4">
